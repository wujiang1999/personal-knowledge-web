# PostgreSQL connection string (self-hosted on the ECS instance).
# Replace both the user and password placeholders with real values.
# For local testing through a `workbench forward` tunnel, use 127.0.0.1:5432.
# For Vercel, point this at a publicly reachable endpoint (EIP / NAT / tunnel).
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/knowledge

# Secret used to sign the session JWT. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Default admin username (password is set once by `npm run db:seed`)
ADMIN_USERNAME=admin
# Required for `npm run db:seed` — the seed fails loudly if this is unset.
# Do not reuse a known default.
ADMIN_PASSWORD=CHANGE_ME

# Directory where uploaded attachment bytes are stored (optional).
# Defaults to ./data/attachments relative to the app working directory.
ATTACHMENT_DIR=./data/attachments

# Total attachment storage allowed per user. Must be at least 104857600
# (the 100 MiB individual-file cap). Defaults to 2147483648 (2 GiB).
MAX_TOTAL_ATTACHMENT_BYTES=2147483648

# Force the session cookie Secure flag. Defaults to NODE_ENV=production.
# Set "false" ONLY if the app is served over plain HTTP (public-IP access);
# keep it secure (or omit) when behind HTTPS.
SESSION_COOKIE_SECURE=true
