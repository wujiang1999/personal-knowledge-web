# PostgreSQL connection string (self-hosted on the ECS instance).
# Replace both the user and password placeholders with real values.
# For local testing through a `workbench forward` tunnel, use 127.0.0.1:5432.
# For Vercel, point this at a publicly reachable endpoint (EIP / NAT / tunnel).
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@127.0.0.1:5432/knowledge

# Secret used to sign the session JWT. Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Default admin username (password is set once by `npm run db:seed`)
ADMIN_USERNAME=admin
# Required for `npm run db:seed` — the seed fails loudly if this is unset.
# Do not reuse a known default.
ADMIN_PASSWORD=CHANGE_ME

# Directory where uploaded attachment bytes are stored (optional).
# Defaults to ./data/attachments relative to the app working directory.
ATTACHMENT_DIR=./data/attachments

# Total attachment storage allowed per user. Must be at least 104857600
# (the 100 MiB individual-file cap). Defaults to 2147483648 (2 GiB).
MAX_TOTAL_ATTACHMENT_BYTES=2147483648

# Force the session cookie Secure flag. Defaults to NODE_ENV=production.
# Set "false" ONLY if the app is served over plain HTTP (public-IP access);
# keep it secure (or omit) when behind HTTPS.
SESSION_COOKIE_SECURE=true

# ---- Optional LLM integration (OpenAI-compatible; empty = feature off) ----
# Chat LLM for ingest atomization (npm run ingest) and auto summary.
# Example: https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Ask (/api/ask) weak-retrieval short circuit: below these floors the question is
# answered with "too weakly related" instead of paying for an LLM call. Top-1
# similarity applies when the semantic path attached one, otherwise the lexical
# score. Defaults calibrated 2026-09-10 against a 41-entry library: relevant
# questions scored 0.34-0.63 similarity / 8-29 lexical, off-topic ones 0.12-0.16
# / 3.7. Re-calibrate when the corpus scale changes.
ASK_MIN_SIMILARITY=0.25
ASK_MIN_SCORE=5

# Auto-fill a missing description after concept saves ("1"/"on"/"true").
# Human-written descriptions are never overwritten; failures never block saves.
LLM_AUTO_SUMMARY=

# Embedding endpoint for semantic search (pgvector). Falls back to LLM_BASE_URL
# / LLM_API_KEY when the dedicated vars are unset. LLM_EMBEDDING_DIMENSIONS is
# required and must match the model's output (e.g. 1024 for bge-m3).
LLM_EMBEDDING_BASE_URL=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=
LLM_EMBEDDING_DIMENSIONS=
