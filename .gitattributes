# The deliverable moves between Windows authoring, macOS migration, and a Linux
# server. CRLF in a `.sh` is fatal (`bash -n` fails at the first `{`), and CRLF
# anywhere else produces a 40-file phantom diff that makes deploy.sh's
# "refusing to deploy with tracked, uncommitted changes" guard fire on a tree
# that has no real edits. Normalize text to LF on check-in and check-out.
* text=auto eol=lf

# Executables and configs consumed by Linux tools: LF unconditionally.
*.sh text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf
*.conf text eol=lf
*.local text eol=lf
*.ps1 text eol=crlf
*.sql text eol=lf

# Source and docs.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Never touch binaries: a line-ending rewrite silently corrupts them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.pdf binary
*.zip binary
*.apk binary
*.keystore binary
*.pem binary
*.p12 binary
*.woff binary
*.woff2 binary
